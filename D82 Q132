#include <stdio.h>
#include <string.h>

enum TrafficLight
{
    RED,
    YELLOW,
    GREEN
};

int main()
{
    char light[20];

    printf("Enter traffic light: ");
    scanf("%19s", light);

    if(strcmp(light, "RED") == 0)
    {
        printf("Stop");
    }
    else if(strcmp(light, "YELLOW") == 0)
    {
        printf("Wait");
    }
    else if(strcmp(light, "GREEN") == 0)
    {
        printf("Go");
    }
    else
    {
        printf("Invalid traffic light");
    }

    return 0;
}
