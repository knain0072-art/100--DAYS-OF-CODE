#include <stdio.h>

int main()
{
    FILE *fp;
    char filename[100];
    char text[500];

    printf("Enter filename: ");
    scanf("%99s", filename);

    fp = fopen(filename, "a");

    if(fp == NULL)
    {
        printf("Unable to open file!");
        return 1;
    }

    getchar();  // Remove newline left by scanf()

    printf("Enter text to append: ");
    fgets(text, sizeof(text), stdin);

    fprintf(fp, "%s", text);

    fclose(fp);

    printf("File updated successfully with appended text.");

    return 0;
}
