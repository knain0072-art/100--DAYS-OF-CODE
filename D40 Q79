#include <stdio.h>

int main()
{
    int r, c, i, j, k;
    int a[100][100];

    scanf("%d %d", &r, &c);

    for(i = 0; i < r; i++)
    {
        for(j = 0; j < c; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }

    for(k = 0; k < r + c - 1; k++)
    {
        if(k % 2 == 0)
        {
            i = (k < r) ? k : r - 1;
            j = k - i;

            while(i >= 0 && j < c)
            {
                printf("%d ", a[i][j]);
                i--;
                j++;
            }
        }
        else
        {
            j = (k < c) ? k : c - 1;
            i = k - j;

            while(j >= 0 && i < r)
            {
                printf("%d ", a[i][j]);
                i++;
                j--;
            }
        }
    }

    return 0;
}
