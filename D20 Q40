#include <stdio.h>

int main()
{
    long long n, digit, place = 1;
    long long result = 0;

    scanf("%lld", &n);

    while (n > 0)
    {
        digit = n % 10;

        if (digit == 0)
        {
            result = result + 1 * place;
        }
        else if (digit == 1)
        {
            result = result + 0 * place;
        }

        place = place * 10;
        n = n / 10;
    }

    printf("%lld", result);

    return 0;
}
