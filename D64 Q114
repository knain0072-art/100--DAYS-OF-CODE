#include <stdio.h>
#include <string.h>

int main()
{
    char s[1000];
    int i, j;
    int maxLength = 0, length;

    scanf("%s", s);

    int n = strlen(s);

    for(i = 0; i < n; i++)
    {
        int visited[256] = {0};

        length = 0;

        for(j = i; j < n; j++)
        {
            if(visited[(unsigned char)s[j]] == 1)
            {
                break;
            }

            visited[(unsigned char)s[j]] = 1;
            length++;
        }

        if(length > maxLength)
        {
            maxLength = length;
        }
    }

    printf("%d", maxLength);

    return 0;
}
