#include <stdio.h>

int main()
{
    FILE *fp;
    int n, i;
    char name[50];
    int roll;
    float marks;

    fp = fopen("students.txt", "w");

    if(fp == NULL)
    {
        printf("Error opening file!");
        return 1;
    }

    printf("Enter number of students: ");
    scanf("%d", &n);

    // Write student records into the file
    for(i = 0; i < n; i++)
    {
        printf("Enter name, roll number and marks: ");
        scanf("%49s %d %f", name, &roll, &marks);

        fprintf(fp, "%s %d %.2f\n", name, roll, marks);
    }

    fclose(fp);

    // Open file for reading
    fp = fopen("students.txt", "r");

    if(fp == NULL)
    {
        printf("Error reading file!");
        return 1;
    }

    printf("\nStudent Records:\n");

    // Read and display student records
    while(fscanf(fp, "%49s %d %f", name, &roll, &marks) == 3)
    {
        printf("Name: %s | Roll: %d | Marks: %.0f\n",
               name, roll, marks);
    }

    fclose(fp);

    return 0;
}
